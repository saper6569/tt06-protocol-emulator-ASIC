SIM ?= icarus
TOPLEVEL_LANG ?= verilog
UNIT ?= instruction_memory

SRC_DIR := $(abspath ../src)
VERILOG_SOURCES := $(SRC_DIR)/$(UNIT).v
ifeq ($(UNIT),processor)
VERILOG_SOURCES += $(SRC_DIR)/timer.v
endif
ifeq ($(UNIT),io_port)
VERILOG_SOURCES += $(PWD)/tb_io_port.v
endif
SIM_BUILD := sim_build/units/$(UNIT)
TOPLEVEL := $(UNIT)
ifeq ($(UNIT),io_port)
TOPLEVEL := tb_io_port
endif
COCOTB_TEST_MODULES := test_$(UNIT)
COMPILE_ARGS += -g2012

include $(shell cocotb-config --makefiles)/Makefile.sim
